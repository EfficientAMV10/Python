student_scores = {
    'Harry': 88,
    'Ron': 78,
    'Hermione': 95,
    'Draco': 75,
    'Neville': 60
}

student_grades ={}

for keys,values in student_scores.items():
    if values >= 91:
        student_grades[keys] = "Outstanding"
    if  81<= values <= 90:
        student_grades[keys] = "Exceeds Expectations" 
    if 71 <= values <= 80:
        student_grades[keys] = "Acceptable"
    if values<= 70:
        student_grades[keys] = "Fail"
print(student_grades)        







