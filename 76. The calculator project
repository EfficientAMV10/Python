def sum(a, b):
    return a + b

def subtract(a, b):
    return a - b

def multiply(a, b):
    return a * b

def divide(a, b):
    return a / b


while True:

    a = float(input("What's the first number? \n"))
    symbol = input("""Select the operation:
+
-
*
/
""")
    b = float(input("What's the next number? \n"))

    if symbol == "+":
        print(sum(a,b))  
    
    elif symbol == "-":
        print(subtract(a,b))
    
    elif symbol == "*":
        print(multiply(a,b))
    
    elif symbol == "/":
        print(divide)

    input("Type 'y' to continue ")
