import random

def deal_card():
    """Returns a random card from the deck"""
    cards = [11,2,3,4,5,6,7,8,9,10,10,10,10]
    card =  random.choice(cards) 
    return card

def calculate_score(a):
    """Take a list of cardsd and return the score calculated from the cards"""
    if sum(a) == 21 and len(a) == 2:
        return 0
    if 11 in a and sum(a) > 21:
        a.remove(11)
        a.append(1)

    return sum(a)
def compare(u_score, comp_score):
    if u_score == comp_score:
        return "Draw"
    elif comp_score == 0:
        return "Mr.House has WON." 
    elif u_score == 0:
        return "You WIN with a Blackjack!"
    elif u_score >21:
        return "You went over 21. Mr.House, WON."
    elif comp_score > 21:
        return "Mr.House went over. You WIN."
    elif u_score > comp_score:
        return "You WIN."
    else:
        return "You LOSE."

